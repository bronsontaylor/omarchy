#!/bin/bash

# omarchy:summary=Cache dock artwork trimmed to its visible bounds
# omarchy:hidden=true

python - "$@" <<'PYTHON'
"""Cache alpha-trimmed artwork without changing the source icon."""
import hashlib
import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path
from urllib.parse import unquote, urlparse

source = sys.argv[1] if len(sys.argv) > 1 else ""
try:
    parsed = urlparse(source)
    path = Path(unquote(parsed.path) if parsed.scheme in ("file", "qs") else source)
    if not path.is_file():
        raise ValueError("not a local icon")
    stamp = path.stat()
    key = hashlib.sha256(f"{path}:{stamp.st_mtime_ns}:{stamp.st_size}:trim-v3".encode()).hexdigest()
    cache = Path(os.environ.get("XDG_CACHE_HOME", str(Path.home() / ".cache"))) / "omarchy-dock-icons"
    cache.mkdir(parents=True, exist_ok=True)
    output = cache / (key + ".png")
    if not output.exists():
        with tempfile.TemporaryDirectory(prefix="dock-icon-", dir=cache) as temp:
            final = Path(temp) / "trimmed.png"
            subprocess.run(["magick", "-background", "none", "-density", "768", str(path) + "[0]",
                            "-bordercolor", "none", "-border", "1", "-trim", "+repage", "-resize", "x256", str(final)],
                           check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)
            os.replace(final, output)
    dimensions = subprocess.check_output(["magick", "identify", "-format", "%w %h", str(output)],
                                         text=True, timeout=5).split()
    print(json.dumps({"source": output.as_uri(), "ratio": int(dimensions[0]) / int(dimensions[1])}))
except (OSError, ValueError, subprocess.SubprocessError):
    print(json.dumps({"source": source, "ratio": 1}))
PYTHON
